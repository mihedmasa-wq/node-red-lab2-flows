    {
        "id": "93550a31da072c91",
        "type": "function",
        "z": "5847e73d379f0379",
        "name": "smart counter",
        "func": "// Получаем текущее значение счётчика из flow context\nlet counter = flow.get(\"counter\") || 0;\n// Увеличиваем счётчик\ncounter = counter + 1;\n// Проверяем, достиг ли счётчик лимита\nif (counter >= 5) {\n    // Сбрасываем счётчик\n    flow.set(\"counter\", 0);\n    \n    msg.payload = {\n        action: \"limit_reached\",\n        message: \"Достигнут лимит (5)! Счётчик сброшен.\",\n        counter: counter,\n        timestamp: new Date().toISOString()\n    };\n    return [null, msg]; // второй выход — сообщение о лимите\n}\n// Сохраняем значение в flow context\nflow.set(\"counter\", counter);\n// Обычное сообщение\nmsg.payload = {\n    action: \"increment\",\n    counter: counter,\n    message: \"Счётчик увеличен\",\n    timestamp: new Date().toISOString()\n};\nreturn [msg, null]; // первый выход — обычное сообщение",
